program GlobalGenericMethods

interface Printable {
    void printMe();
}

class Base extends Printable {
    int value;
    {
        int getValue() {
            return this.value + 3;
        }

        void printMe() {
            print(this.value);
        }
    }
}

class Derived extends Base {}
{
    <T> T identity(T value) {
        return value;
    }

    <T> T[] singleton(T value) T values[]; {
        values = new T[1];
        values[0] = value;
        return values;
    }

    <U> U forward(U value) {
        return identity(value);
    }

    <T extends Base> int readValue(T value) {
        return value.getValue();
    }

    <T extends Printable> void printMe(T value) {
        value.printMe(); print(eol);
    }

    void main() int number; char letter; int numbers[]; char letters[]; Derived object; Base baseValues[]; {
        number = identity(3);
        letter = identity::<char>('A');
        numbers = singleton(7);
        letters = singleton::<char>('Z');

        print(number);
        print(letter);
        print(numbers[0]);
        print(letters[0]);
        print(forward::<int>(9));
        object = new Derived();
        object.value = 4;
        print(readValue::<Derived>(object));
        print(eol);

        baseValues = new Derived[2];
        baseValues[0] = new Derived();
        baseValues[0].value = 1;
        baseValues[1] = new Derived();
        baseValues[1].value = 2;

        for (number = 0; number < 2; number++) {
            printMe::<Base>(baseValues[number]);
        }

        print(identity::<int> map numbers);
    }
}