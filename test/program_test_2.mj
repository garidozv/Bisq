// Tests class member access

// Expected output for input 6:
// 17        10 1 6 20  2

program Test

const bool o = false;

int arr[];

class N { 
	int n; 
	{
		int meth1() { return 1;}
		int meth2() { return 2;}
	} 
}

class A {
	int a[];
	int x;
	N m;
	{
		void setX(int a) int c; { c = 10 + 13; }
		int getX() { return 1; }
	}
}

class B extends A {
	{
		void setX(int a) { return; }
		int getX() int x; { x = 7; this.x = 6; return this.x; }
	}
}

class C extends B {
	{
		int getNum() { return 10; }
		int getX() {
			return getNum() + this.getNum();
		}
	}
}
	
{

	int test(int b) { return b + 10; }
	int add4(int a, int b, int c, int d) { return a + b + c + d; }
	
	void main() int num; char ch, ch_arr[]; A a1, a2, a3;	
	{
		num = 2;
		num++;
		num--;
		
		test(num);
		
		arr = new int[10];
		
		read(arr[0]);
		arr[0]++;
		
		print(test(arr[0]), 2);
		print(add4(1, 2, 3, 4), 10);
		
		a1 = new A();
		a2 = a1;
		a1.a = arr;
		a1.x = a1.getX();
		
		print(a1.getX(), 2);
		a2 = new B();
		a2.x = 8;
		print(a2.getX(), 2);
		a3 = new C();
		print(a3.getX(), 3);
		
		a1.x++;
		a1.a[0]--;
		
		a1.m = new N();
		a1.m.n = 2;
		a1.a = new int[2];
		a1.a[0] = 9;
		arr[3] = a1.a[1] + a1.m.n;
		
		print(arr[3], 3);
		
		ch_arr = new char[6];
		ch_arr[4] = 'b';
		ch = ch_arr[4];
	}
}


