package rs.ac.bg.etf.pp1;

import java_cup.runtime.*;
import org.apache.log4j.*;
import rs.ac.bg.etf.pp1.ast.*;


parser code {:
	
	boolean loggingEnabled = false;
	boolean errorDetected = false;
	Logger log = Logger.getLogger(getClass());

   	// Redefined error-reporting methods
     
    public void report_fatal_error(String message, Object info) throws java.lang.Exception {
      done_parsing();
      report_error(message, info);
    }
  
    public void syntax_error(Symbol cur_token) {
        report_error("\nSyntax error", cur_token);
    }
  
    public void unrecovered_syntax_error(Symbol cur_token) throws java.lang.Exception {
        report_fatal_error("Fatal error, parsing cannot be continued", cur_token);
    }

    public void report_error(String message, Object info) {
    	errorDetected = true;
    	report_info(message, info);
    }
    
    public void report_info(String message, Object info) {
    	StringBuilder msg = new StringBuilder(message); 
    	if (info instanceof Symbol) {
    		msg.append(" on line ").append(((Symbol)info).left);
    		msg.append(" at symbol '").append(((Symbol)info).value).append("'");
    	}
        log.info(msg.toString());
    }
    
    public void report_recovered_error() {
    	log.info("Error recovery successful, parsing will be continued");
    }
:}

scan with {:
	Symbol s = this.getScanner().next_token();
	if (loggingEnabled && s != null && s.value != null) 
		log.info(s.toString() + " " + s.value.toString());
	return s;
:}

terminal  
	PROGRAM, DOT, LBRACK, RBRACK, INTERFACE, RPAREN, IF, CLASS, BREAK, ELSE, 
	GT, NEW, RBRACE, LT, GE, CONTINUE, MAP, DEC, MUL, LE, CONST,
	PRINT, LPAREN, READ, NE, ADD, SUB, INC, LBRACE, DIV, OR, AND, RETURN,
	EQ, EQUAL, VOID, MOD, UNION, DO, COMMA, WHILE, SEMI, EXTENDS, COL, QMARK, FOR,
	TURBOFISH;
	
terminal String IDENT;
terminal String STRING;
terminal Integer NUMBER;
terminal Character CHAR;
terminal Boolean BOOL;

nonterminal 
	Setop, Relop, Mulop, Addop, Assignop, Label, DoToken, CondTerm,
	DesignatorStatement, Statement, FormPars, Condition, ElseToken,
	StatementList, VarDeclList, MethodSignature,
	InterfaceBody, ClassBody, MethodDeclList, VarDecl, ProgramDeclarations,
	VarDeclNoType, VarName, ConstDecl, ConstDeclNoType, ConstAssign, 
	ProgramName, Program, ProgramDeclList, MethodReturnType, WhileToken,
	FormParVar, ClassName, ExtendedTypeName, InterfaceName,
	ConditionList, CondTermList, ColToken, ForInitializer, ForCondition, ForPostStatement,
	GenericMethodSignature, TypeParameters, TypeParameterList, GenericParameterScopeStart;

nonterminal rs.ac.bg.etf.pp1.symbolTable.generics.TypeArguments
	TypeArgumentList;
	
nonterminal rs.etf.pp1.symboltable.concepts.Obj
	Designator, MethodName, ClassDecl, InterfaceDecl, MethodDecl, GenericMethodDecl, CallableRef, TypeParameter;
	
nonterminal rs.etf.pp1.symboltable.concepts.Struct
	ExprNonTern, ExprTern, Expr, ExprList, Factor, Term, CallPars, ActPars, CondFact, Type, TypeAtom;
	
precedence left ELSE;

Program ::= (Program) PROGRAM ProgramName ProgramDeclarations LBRACE MethodDeclList RBRACE
			;
			
ProgramName ::=	(ProgramName) IDENT
				;
				
ProgramDeclarations ::= (ProgramDeclarations) ProgramDeclList
						;

ProgramDeclList ::=	(ProgramDeclList_ConstDecl) ProgramDeclList ConstDecl
					|
					(ProgramDeclList_VarDecl) ProgramDeclList VarDecl
					|
					(ProgramDeclList_ClassDecl) ProgramDeclList ClassDecl
					|
					(ProgramDeclList_InterfaceDecl) ProgramDeclList InterfaceDecl
					|
					(ProgramDeclList_Epsilon) /* epsilon */
					;

ConstAssign ::=	(ConstAssign_Num) IDENT EQUAL NUMBER
				|
				(ConstAssign_Char) IDENT EQUAL CHAR
				|
				(ConstAssign_Bool) IDENT EQUAL BOOL
				;

ConstDeclNoType ::=	(ConstDeclNoType_ConstAssing) ConstDeclNoType COMMA ConstAssign
					|
					(ConstDeclNoType_Epsilon) /* epsilon */
					;

ConstDecl ::= 	(ConstDecl) CONST Type ConstAssign ConstDeclNoType SEMI
				;

VarName ::=	(VarName_NonArray) IDENT 
			|
			(VarName_Array) IDENT LBRACK RBRACK
			;

VarDeclNoType ::= 	(VarDeclNoType_VarName) VarDeclNoType COMMA VarName
					|
					(VarDeclNoType_Error) error
					{: parser.report_recovered_error(); :}
					|
					(VarDeclNoType_Epsilon) /* epsilon */
					;

VarDecl ::=	(VarDecl_Valid) Type VarName VarDeclNoType SEMI
			|
			(VarDecl_Error) error SEMI
			{: parser.report_recovered_error(); :}
			;

MethodDeclList ::=	(MethodDeclList_MethodDecl) MethodDeclList MethodDecl
					|
					(MethodDeclList_GenericMethodDecl) MethodDeclList GenericMethodDecl
					|
					(MethodDeclList_Epsilon) /* epsilon */
					;

ClassBody ::=	(ClassBody_Fields) VarDeclList
				|
				(ClassBody_FieldsAndMethods) VarDeclList LBRACE MethodDeclList RBRACE
				;

ClassDecl ::= 	(ClassDecl_Derived) CLASS ClassName EXTENDS ExtendedTypeName LBRACE ClassBody RBRACE
				|
				(ClassDecl_NonDerived) CLASS ClassName LBRACE ClassBody RBRACE
				;
				
ExtendedTypeName ::= 	(ExtendedTypeName_Valid) Type
						|
						(ExtendedTypeName_Error) error
						{: parser.report_recovered_error(); :}
						;
				
ClassName ::=	(ClassName_Regular) IDENT
				|
				(ClassName_Generic) IDENT TypeParameters
				;

InterfaceBody ::=	(InterfaceBody_MethodDecl) InterfaceBody MethodDecl
					|
					(InterfaceBody_GenericMethodDecl) InterfaceBody GenericMethodDecl
					|
					(InterfaceBody_MethodSignature) InterfaceBody MethodSignature SEMI 
					|
					(InterfaceBody_Epsilon) /* epsilon */
					; 

InterfaceDecl ::=	(InterfaceDecl) INTERFACE InterfaceName LBRACE InterfaceBody RBRACE
					;
					
InterfaceName ::=	(InterfaceName_Regular) IDENT
					|
					(InterfaceName_Generic) IDENT TypeParameters
					;

MethodSignature ::=	(MethodSignature_NoPars) MethodReturnType MethodName LPAREN RPAREN
					|
					(MethodSignature_Pars) MethodReturnType MethodName LPAREN FormPars RPAREN
					;

GenericMethodSignature ::=	(GenericMethodSignature_NoPars) TypeParameters MethodReturnType MethodName LPAREN RPAREN
                            |
                            (GenericMethodSignature_Pars) TypeParameters MethodReturnType MethodName LPAREN FormPars RPAREN
                            ;
					
MethodReturnType ::=	(MethodReturnType_Void) VOID
						|
						(MethodReturnType_Type) Type
						;
					
MethodName ::= 	(MethodName) IDENT
				;
				
VarDeclList ::=	(VarDeclList_VarDecl) VarDeclList VarDecl
				|
				(VarDeclList_Epsilon) /* epsilon */
				;
				
MethodDecl ::=	(MethodDecl) MethodSignature VarDeclList LBRACE StatementList RBRACE
				;

GenericMethodDecl ::=	(GenericMethodDecl) GenericMethodSignature VarDeclList LBRACE StatementList RBRACE
					    ;

FormPars ::= 	(FormPars_FormParVar) FormParVar
				|
				(FormPars_FormParVarList) FormPars COMMA FormParVar
				;
				
FormParVar ::=	(FormParVar_NonArray) Type IDENT 
				|
				(FormParVar_Array) Type IDENT LBRACK RBRACK
				|
				(FormParVar_Error) error
				{: parser.report_recovered_error(); :}
				;

TypeParameters ::=	(TypeParameters_Present) LT GenericParameterScopeStart TypeParameterList GT
					;

GenericParameterScopeStart ::=	(GenericParameterScopeStart) /* epsilon */
							    ;

TypeParameterList ::=	(TypeParameterList_Parameter) TypeParameter
						|
						(TypeParameterList_List) TypeParameterList COMMA TypeParameter
						;

TypeParameter ::=	(TypeParameter_Unbounded) IDENT
					|
					(TypeParameter_Bounded) IDENT EXTENDS Type
					;

TypeArgumentList ::=	(TypeArgumentList_Type) Type
                        |
                        (TypeArgumentList_List) TypeArgumentList COMMA Type
                        ;

Type ::=	(Type_Atom) TypeAtom
			|
			(Type_Generic) IDENT LT TypeArgumentList GT
			|
			(Type_Array) Type LBRACK RBRACK
			;

TypeAtom ::=    (TypeAtom_Ident) IDENT
                ;
			
StatementList ::= 	(StatementList_Statement) StatementList Statement
					|
					(StatementList_Epsilon) /* epsilon */
					;

Statement ::= 	(Statement_DesignatorStatement) DesignatorStatement SEMI
				|
				(Statement_If) IF LPAREN Condition RPAREN Statement
				|
				(Statement_IfElse) IF LPAREN Condition RPAREN Statement ElseToken Statement
				|
				(Statement_Break) BREAK SEMI
				|
				(Statement_Continue) CONTINUE SEMI
				|
				(Statement_ReturnVoid) RETURN SEMI
				|
				(Statement_ReturnExpr) RETURN Expr SEMI
				|
				(Statement_Read) READ LPAREN Designator RPAREN SEMI
				|
				(Statement_PrintExpr) PRINT LPAREN Expr RPAREN SEMI
				|
				(Statement_PrintExprWithNum) PRINT LPAREN Expr COMMA NUMBER RPAREN SEMI
				|
				(Statement_PrintString) PRINT LPAREN STRING RPAREN SEMI
				|
				(Statement_DoWhileTrue) DoToken Statement WhileToken LPAREN RPAREN SEMI
				|
				(Statement_DoWhileCondition) DoToken Statement WhileToken LPAREN Condition RPAREN SEMI
				|
				(Statement_DoWhileConditionWithDesignatorStatement) DoToken Statement WhileToken LPAREN Condition COMMA DesignatorStatement RPAREN SEMI
				|
				(Statement_For) FOR LPAREN ForInitializer SEMI ForCondition SEMI ForPostStatement RPAREN Statement
				|
				(Statement_Block) LBRACE StatementList RBRACE
				;
				
ForInitializer ::=	(ForInitializer_DesignatorStatement) DesignatorStatement
					| 
					(ForInitializer_Epsilon) /* epsilon */
					;
					
ForCondition ::=	(ForCondition_Condition) Condition
					|
					(ForCondition_Epsilon) /* epsilon */
					;
					
ForPostStatement ::=	(ForPostStatement_DesignatorStatement) DesignatorStatement
						|
						(ForPostStatement_Epsilon) /* epsilon */
						;
				
ElseToken ::=	(ElseToken) ELSE
				;
				
WhileToken ::=	(WhileToken) WHILE
				;
				
DoToken ::=	(DoToken) DO
			;				

DesignatorStatement ::= (DesignatorStatement_AssignExpr) Designator Assignop Expr
						|
						(DesignatorStatement_Call) CallableRef CallPars
						|
						(DesignatorStatement_Inc) Designator INC
						|
						(DesignatorStatement_Dec) Designator DEC
						|
						(DesignatorStatement_AssignSetop) Designator Assignop Designator Setop Designator
						|
						(DesignatorStatement_Error) error
						{: parser.report_recovered_error(); :}
						;

CallPars ::=	(CallPars_ActPars) LPAREN ActPars RPAREN
				|
				(CallPars_Empty) LPAREN RPAREN
				;
				
ActPars ::=	(ActPars_Expr) Expr
			|
			(ActPars_ExprList) ActPars COMMA Expr
			;

CallableRef ::=	(CallableRef_Plain) Designator
				|
				(CallableRef_Applied) Designator TURBOFISH TypeArgumentList GT
				;
			

Condition ::= 	(Condition_Valid) ConditionList
				|
				(Condition_Error) error
				{: parser.report_recovered_error(); :}
				;
				
ConditionList ::=	(ConditionList_CondTerm) CondTerm
					|
					(ConditionList_OrCondTerm) ConditionList OR CondTerm
					;

CondTerm ::= 	(CondTerm) CondTermList
				;

CondTermList ::= 	(CondTermList_CondFact) CondFact
					|
					(CondTermList_AndCondFact) CondTermList AND CondFact
					;
				
				
CondFact ::=	(CondFact_Expr) ExprNonTern 
				|
				(CondFact_RelopExpr) ExprNonTern Relop ExprNonTern
				;

ExprList ::=	(ExprList_Term) Term
				|
				(ExprList_SubTerm) SUB Term
				|
				(ExprList_AddopTerm) ExprList Addop Term
				;
				
Expr ::=	(Expr_Tern) ExprTern
			|
			(Expr_NonTern) ExprNonTern
			; 

ExprTern ::=	(ExprTern) Condition QMARK Expr ColToken Expr
				;
				
ColToken ::=	(ColToken) COL
				;

ExprNonTern ::=	(ExprNonTern_ExprList) ExprList
				|
				(ExprNonTern_Map) CallableRef MAP Designator
				;	
				
Term ::= 	(Term_Factor) Factor
			|
			(Term_MulopFactor) Term Mulop Factor
			;

Factor ::= 	(Factor_Designator) Designator
			|
			(Factor_DesignatorCall) CallableRef CallPars
			|
			(Factor_NumConst) NUMBER
			|
			(Factor_CharConst) CHAR
			|
			(Factor_BoolConst) BOOL
			|
			(Factor_NewArray) NEW Type LBRACK Expr RBRACK
			|
			(Factor_NewObject) NEW Type CallPars
			|
			(Factor_Expr) LPAREN Expr RPAREN
			;

Designator ::=	(Designator_Ident) IDENT
				|
				(Designator_MemberAccess) Designator DOT IDENT
				|
			 	(Designator_ArrayAccess) Designator LBRACK Expr RBRACK
			 	;

				
Label ::= 	(Label) IDENT
			;
				
Assignop ::=	(Assignop) EQUAL
				;

Relop ::=	(Relop_Equal) EQ
			|
			(Relop_NotEqual) NE
			|
			(Relop_Greater) GT
			|
			(Relop_GreaterOrEqual) GE
			|
			(Relop_Lesser) LT
			|
			(Relop_LesserOrEqual) LE
			;
			
Addop ::=	(Addop_Add) ADD
			|
			(Addop_Sub) SUB
			;
		

Mulop ::= 	(Mulop_Mul) MUL
			|
			(Mulop_Div) DIV
			|
			(Mulop_Mod) MOD
			;

Setop ::= 	(Setop) UNION
			;
