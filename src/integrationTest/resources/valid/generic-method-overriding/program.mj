program GenericMethodOverriding

class Left {}
class Right {}
class Pair<A, B> {}

class Base<A extends Left, B extends Right> {
    {
        <T extends Pair<A, B>, U extends Right> int value(T first, U second) {
            return 1;
        }
    }
}

class Derived<A extends Left, B extends Right> extends Base<A, B> {
    {
        <T extends Pair<A, B>, U extends Right> int value(T first, U second) {
            return 2;
        }
    }
}

class Leaf extends Derived<Left, Right> {
    {
        <T extends Pair<Left, Right>, U extends Right> int value(T first, U second) {
            return 3;
        }
    }
}

interface Provider<A extends Left, B extends Right> {
    <T extends Pair<A, B>, U extends Right> int kind(T first, U second) {
        return 4;
    }
}

class DefaultProvider extends Provider<Left, Right> {}

class ProviderBase extends Provider<Left, Right> {
    {
        <T extends Pair<Left, Right>, U extends Right> int kind(T first, U second) {
            return 5;
        }
    }
}

class ProviderImplementation extends ProviderBase {
    {
        <T extends Pair<Left, Right>, U extends Right> int kind(T first, U second) {
            return 6;
        }
    }
}
{
    void main() Base<Left, Right> base; Provider<Left, Right> provider;
                Pair<Left, Right> first; Right second; {
        first = new Pair<Left, Right>();
        second = new Right();

        base = new Base<Left, Right>();
        print(base.<Pair<Left, Right>, Right>value(first, second));

        base = new Derived<Left, Right>();
        print(base.<Pair<Left, Right>, Right>value(first, second));

        base = new Leaf();
        print(base.<Pair<Left, Right>, Right>value(first, second));

        provider = new DefaultProvider();
        print(provider.<Pair<Left, Right>, Right>kind(first, second));

        provider = new ProviderBase();
        print(provider.<Pair<Left, Right>, Right>kind(first, second));

        provider = new ProviderImplementation();
        print(provider.<Pair<Left, Right>, Right>kind(first, second));
        print(eol);
    }
}
